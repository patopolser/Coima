# Coima backend — environment variables (prefix COIMA_). Copy to .env and fill in.
# .env is gitignored; never commit real keys.

# Neo4j
COIMA_NEO4J_URI=bolt://localhost:7687
COIMA_NEO4J_USER=neo4j
COIMA_NEO4J_PASSWORD=changeme

# AI provider keys (used by the investigation clients)
COIMA_ANTHROPIC_API_KEY=
COIMA_GEMINI_API_KEY=
COIMA_DEEPSEEK_API_KEY=

# Web search (Serper) for the search_web investigation tool
COIMA_SERPER_API_KEY=
