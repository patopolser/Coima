# Coima backend — environment variables (prefix COIMA_). Copy to .env and fill in.
# .env is gitignored; never commit real keys.

# Neo4j
COIMA_NEO4J_URI=bolt://localhost:7687
COIMA_NEO4J_USER=neo4j
COIMA_NEO4J_PASSWORD=changeme

# MCP server (src/mcp_server). No AI keys needed: the agent (Claude Code,
# Codex) brings its own model. Locale for check names in tool output:
# COIMA_MCP_LOCALE=es
# Optional bearer token required on the HTTP endpoint /mcp (stdio ignores it):
# COIMA_MCP_TOKEN=
# Extra Host headers accepted by /mcp besides localhost, comma-separated:
# COIMA_MCP_ALLOWED_HOSTS=
