# Coima — environment configuration.
# Copy to .env and adjust. All vars are optional; sensible local-dev defaults
# apply when unset. The COIMA_ prefix is shared by the backend and the scraper.

# ─── Neo4j ────────────────────────────────────────────────
COIMA_NEO4J_USER=neo4j
COIMA_NEO4J_PASSWORD=coima_password
# URI is set per-service in docker-compose (neo4j://neo4j:7687). For local
# (non-docker) runs, point it at your own instance:
# COIMA_NEO4J_URI=bolt://localhost:7687
# Memory tuning for the dockerized Neo4j. Elastic heap: it grows toward
# HEAP_MAX under load (e.g. the detector's self-joins) and a periodic G1 GC
# returns unused memory to the OS when idle, shrinking back toward HEAP_INIT.
# HEAP_MAX must comfortably exceed the real peak (Neo4j exits on heap OOM), and
# MEM_LIMIT must sit above HEAP_MAX + pagecache + JVM off-heap (~1g). Raise both
# together if you see OutOfMemoryError or container restarts under the detector.
# COIMA_NEO4J_HEAP_INIT=512m
# COIMA_NEO4J_HEAP_MAX=4g
# COIMA_NEO4J_PAGECACHE=512m
# COIMA_NEO4J_MEM_LIMIT=6g

# ─── Scraper ──────────────────────────────────────────────
# Shared control/status directory. In docker this is the mounted volume and is
# set by compose; only override for local runs.
# COIMA_OUTPUT_DIR=/data/scraper-output
# COIMA_SCRAPER_CONTROL_DIR=/data/scraper-output
# COIMA_BATCH_SIZE=5
# COIMA_LOG_LEVEL=INFO
# Crawl delay in seconds between requests (default 1.0). Keep it at 1s or
# above for bulk runs; see the scraping-ethics section of scraper/README.md.
# COIMA_REQUEST_DELAY=1.0

# ─── AI keys (optional — only needed for AI-assisted investigations) ──
# COIMA_ANTHROPIC_API_KEY=
# COIMA_GEMINI_API_KEY=
# COIMA_DEEPSEEK_API_KEY=

# ─── API protection (backend; 0 disables each one) ────────
# Max requests per client IP per 60s window.
# COIMA_RATE_LIMIT_PER_MINUTE=240
# Min seconds between accepted runs of the expensive triggers (detection run,
# scraper start/rescrape/indicator refresh).
# COIMA_TRIGGER_COOLDOWN_SECONDS=60
# Max accepted request body size in bytes.
# COIMA_MAX_BODY_BYTES=1000000
# Allowed CORS origins, comma-separated. "*" (default) allows any origin;
# empty means same-origin only, correct behind a reverse proxy that serves
# both the SPA and the API.
# COIMA_CORS_ORIGINS=*
